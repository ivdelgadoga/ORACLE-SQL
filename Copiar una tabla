-- Copiar una tabla

CREATE TABLE ATC_LECTURA_COPIA AS
SELECT *
FROM ATC_LECTURA 
WHERE TIPOLECTURA IN('Especial CC', 'Especial CC Cyberideas', 'Especial CC Retencion')
AND FECHACREADO >= TIMESTAMP '2026-10-01 00:00:00'
AND FECHACREADO < TIMESTAMP '2026-11-01 00:00:00';

-- Obtener el último valor de la sequencia

SELECT NVL(MAX(ID), 0) AS MAX_ID
FROM ATC_LECTURA_COPIA;

-- 15581

-- Crear la sequencia (+1)

CREATE SEQUENCE ATC_LECTURA_COPIA_SEQ
START WITH 15582
INCREMENT BY 1
NOCACHE
NOCYCLE;

-- Crear el trigger

CREATE OR REPLACE TRIGGER ATC_LECTURA_COPIA_TRG
BEFORE INSERT ON ATC_LECTURA_COPIA
FOR EACH ROW
BEGIN
    IF :NEW.ID IS NULL THEN
        SELECT ATC_LECTURA_COPIA_SEQ.NEXTVAL
        INTO :NEW.ID
        FROM DUAL;
    END IF;
END;
/

-- Confirmar el trigger

SELECT  
    TRIGGER_NAME,
    TABLE_NAME
    STATUS
FROM USER_TRIGGERS
WHERE TRIGGER_NAME = 'ATC_LECTURA_COPIA_TRG';
