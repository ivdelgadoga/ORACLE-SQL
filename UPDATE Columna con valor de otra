SET IDSIEBEL = 'CCMX' || NUMEMPLEADO
WHERE NUMEMPLEADO
IN ('10001565', '10025117', '10001564', '10001636', '10001637', '10001561', '10001566', '10007384', '10001563', '10001614', '10001562', '10001615', '10001616');
